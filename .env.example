# Copia este fichero como .env.local y rellena lo que falte.
#   cp .env.example .env.local
# .env.local NO se sube a git (está en .gitignore). Este sí, y sin valores.

# ---------------------------------------------------------------------------
# 1. Modo del proyecto
# ---------------------------------------------------------------------------
# static = web sola: sin base de datos, sin panel /back y los servicios salen
#          de los ficheros del código.
# full   = web con panel: usa Supabase, guarda citas y /back funciona.
#
# Para una peluquería con control de citas: full.
NEXT_PUBLIC_SITE_MODE=full

# ---------------------------------------------------------------------------
# 2. Supabase (obligatorio en modo full)
# ---------------------------------------------------------------------------
# Project Settings > API en supabase.com. La clave `anon` (o `publishable`, que
# es su versión nueva) es pública y está pensada para el navegador.
#
# NO hace falta la clave `service_role`: este proyecto no la usa. Esa se salta
# la seguridad de las filas y no hay ningún sitio que la necesite.
#
# Con estas dos vacías el sitio baja a modo static y /back responde 404.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# 3. WhatsApp (obligatorio)
# ---------------------------------------------------------------------------
# Formato internacional sin "+" ni espacios: 34 600 000 000 -> 34600000000
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER=34600000000

# ---------------------------------------------------------------------------
# 4. Mapa (opcional)
# ---------------------------------------------------------------------------
# Token PÚBLICO (empieza por pk.), se expone en el cliente a propósito.
# Sin él la sección "Visítanos" muestra la dirección con un enlace a Google Maps.
# En producción, restrínjelo por dominio en Mapbox:
# Settings > Tokens > Public tokens > Restrict > Allowed URLs
#   https://api.mapbox.com
#   https://events.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---------------------------------------------------------------------------
# 5. Dominio (opcional en Vercel)
# ---------------------------------------------------------------------------
# Déjala vacía: el dominio del proyecto se detecta solo. Solo rellénala si
# compras un dominio propio, para que el sitemap y los enlaces de compartir
# apunten al bueno.
NEXT_PUBLIC_SITE_URL=