# --- Sitio ------------------------------------------------------------------
# Déjala vacía en Vercel: el dominio del proyecto se detecta solo.
# Solo rellénala si compras un dominio propio.
NEXT_PUBLIC_SITE_URL=

# --- Modo del proyecto ------------------------------------------------------
# static = web sola, sin base de datos y sin panel /back
# full   = web con Supabase, panel /back y citas guardadas
# Si no la pones, se deduce: si hay credenciales de Supabase, full.
NEXT_PUBLIC_SITE_MODE=static

# --- WhatsApp (obligatorio para CTAs y el flujo de reserva) -----------------
# Formato internacional sin "+", solo dígitos: 34 600 000 000 -> 34600000000
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER=34600000000

# --- Mapbox ----------------------------------------------------------------
# Token PÚBLICO (empieza por pk.). Se expone en el cliente a propósito, así que
# en producción conviene restringirlo por dominio en la cuenta de Mapbox:
# Settings > Tokens > Public tokens > Restrict > Allowed URLs.
#   https://api.mapbox.com
#   https://events.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Supabase (solo en modo full) -------------------------------------------
# SIN estas tres, el sitio funciona en modo estático y /back da 404.
# Project Settings > API. La service_role NO va nunca en el navegador ni en
# una variable NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=